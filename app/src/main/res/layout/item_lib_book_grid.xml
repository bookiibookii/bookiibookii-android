<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="4dp"
    android:layout_marginStart="4dp"
    android:layout_marginBottom="40dp">
    <LinearLayout
        android:id="@+id/spine_container"
        android:layout_width="32dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_lib_chip"
        android:gravity="bottom|center_horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/item_book_grid_tv"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="책 제목"
            android:rotation="-90"
            android:transformPivotX="16dp"
            android:transformPivotY="15dp"
            android:translationX="-84dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:textAppearance="@style/medium15"
            android:textColor="@color/pre_main" />
    </LinearLayout>
</LinearLayout>