<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="4dp"
    android:layout_marginStart="4dp"
    android:layout_marginBottom="40dp">

    <FrameLayout
        android:id="@+id/spine_container"
        android:layout_width="32dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_lib_spine">

        <TextView
            android:id="@+id/item_book_grid_tv"
            android:layout_width="100dp"  android:layout_height="32dp"  android:layout_gravity="center"
            android:gravity="center_vertical|end" android:paddingStart="16dp" android:text="책 제목"
            android:rotation="90"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="@style/medium15" />
    </FrameLayout>
</LinearLayout>