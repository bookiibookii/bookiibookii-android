<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_bottom_sheet_round">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />

    <View
        android:id="@+id/lib_dialog_handler"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/ic_handlebar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/lib_dialog_criteria_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/medium20"
        android:textColor="@color/grey_900"
        android:layout_marginTop="20dp"
        android:text="서재 관리"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_dialog_handler"/>

    <View
        android:id="@+id/lib_line_v"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grey_200"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/lib_dialog_criteria_tv"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"/>

    <TextView
        android:id="@+id/lib_dialog_group_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/semibold18"
        android:textColor="@color/grey_900"
        android:layout_marginTop="20dp"
        android:text="그룹 상세페이지"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_line_v"/>

    <TextView
        android:id="@+id/lib_dialog_delete_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/semibold18"
        android:textColor="@color/ui_point_red"
        android:layout_marginTop="16dp"
        android:text="서재 삭제"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_dialog_group_tv"/>


</androidx.constraintlayout.widget.ConstraintLayout>