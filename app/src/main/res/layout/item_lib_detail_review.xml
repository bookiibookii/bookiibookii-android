<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="164dp"
    android:layout_height="232dp"

    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">
        <ImageView
            android:id="@+id/item_review_profile_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_round_10dp_gray300"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/item_review_name_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kanghunsim"
            android:textAppearance="@style/medium11"
            android:textColor="@color/grey_900"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/item_review_profile_iv"
            app:layout_constraintTop_toTopOf="@id/item_review_profile_iv"
            app:layout_constraintBottom_toBottomOf="@id/item_review_profile_iv"
            />

        <TextView
            android:id="@+id/item_review_text_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="여기서 개뿔을... 도망가길 뭘 도망가 그만 웃겨라ㅜㅜ 아니 그리고 노엘..."
            android:textAppearance="@style/regular10"
            android:textColor="@color/grey_600"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/item_review_profile_iv"
            app:layout_constraintTop_toBottomOf="@id/item_review_name_iv"
            app:layout_constraintEnd_toEndOf="parent"
             />

        <!-- 사진 -->
        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_round_8dp_gray300"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/item_review_text_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
             />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
