<?xml version="1.0" encoding="utf-8"?>
<!--
  공통 토스트
  - 배경: 흰 + grey200 보더 + round20
  - 패딩 16dp, 좌우 마진 24dp
  - 아이콘 24dp + 8dp 간격 + 텍스트(regular14 grey700, 줄바꿈 허용)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:background="@drawable/bg_toast_round_20"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/toast_icon_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_check" />

    <TextView
        android:id="@+id/toast_message_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/pretendard_variable"
        android:text="토스트 메시지입니다."
        android:textColor="@color/grey_700"
        android:textSize="14sp" />

</LinearLayout>
