<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_white_stroke_circle"
    android:padding="8dp"
    android:gravity="center"
    android:elevation="10dp">

    <!-- 그룹 -->
    <LinearLayout
        android:id="@+id/itemGroup"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_grey100_circle">

        <ImageView
            android:id="@+id/ivGroup"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_group_32"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="그룹"
            android:textSize="11sp"
            android:textColor="@color/grey_900"
            android:fontFamily="@font/pretendard_medium"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 트래커 -->
    <LinearLayout
        android:id="@+id/itemTracker"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivTracker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_tracker_32"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvTracker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="트래커"
            android:textSize="11sp"
            android:textColor="@color/grey_900"
            android:fontFamily="@font/pretendard_medium" />
    </LinearLayout>

    <!-- 서재 -->
    <LinearLayout
        android:id="@+id/itemLibrary"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivLibrary"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_book_32"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvLibrary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="서재"
            android:textSize="11sp"
            android:textColor="@color/grey_900"
            android:fontFamily="@font/pretendard_medium" />
    </LinearLayout>

</LinearLayout>
