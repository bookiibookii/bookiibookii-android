<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item_member_profile_card"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/item_member_profile_Iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />

    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:id="@+id/item_member_nickname_Tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/pretendard_variable"
        android:text="닉네임"
        android:textColor="@color/grey_900"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/item_member_profile_card"
        app:layout_constraintStart_toEndOf="@id/item_member_profile_card"
        app:layout_constraintTop_toTopOf="@id/item_member_profile_card" />

    <com.google.android.material.chip.Chip
        android:id="@+id/item_member_host_Cp"
        style="@style/Widget.App.Chip.host"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        android:layout_marginStart="8dp"
        android:text="HOST"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/item_member_nickname_Tv"
        app:layout_constraintTop_toTopOf="@id/item_member_nickname_Tv"
        app:layout_constraintBottom_toBottomOf="@id/item_member_nickname_Tv"/>

</androidx.constraintlayout.widget.ConstraintLayout>