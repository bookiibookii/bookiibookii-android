<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_shipped_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="24dp">

    <View
        android:id="@+id/view_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/grey_200" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="게스트가 책을 발송했어요!"
        android:textColor="@color/grey_900"
        android:textSize="20sp"
        android:fontFamily="@font/pretendard_medium" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="책을 받은 후 수령 인증을 진행해주세요."
        android:textColor="@color/grey_500"
        android:textSize="14sp"
        android:fontFamily="@font/pretendard_regular" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tracking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/grey_100"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey_200">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_courier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CJ대한통운"
                android:textColor="@color/grey_900"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_regular"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tv_tracking_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="1234123412"
                android:textColor="@color/pre_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/pretendard_medium"
                android:includeFontPadding="false"
                app:layout_constraintStart_toEndOf="@id/tv_courier"
                app:layout_constraintTop_toTopOf="@id/tv_courier"
                app:layout_constraintBottom_toBottomOf="@id/tv_courier" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_shipping_photo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="배송 인증 사진 보기"
        android:textColor="@color/grey_900"
        android:textSize="15sp"
        android:fontFamily="@font/pretendard_medium"
        app:cornerRadius="20dp"
        app:backgroundTint="@android:color/white"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey_200" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_do_receive_confirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="수령 인증하기"
        android:textColor="@color/grey_100"
        android:textSize="15sp"
        android:fontFamily="@font/pretendard_medium"
        android:backgroundTint="@color/grey_900"
        app:cornerRadius="20dp" />

</LinearLayout>
