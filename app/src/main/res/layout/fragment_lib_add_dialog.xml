<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_round"
    >

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <View
        android:id="@+id/lib_add_dialog_handler"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/ic_handlebar"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 프로필 -->
    <ImageView
        android:id="@+id/lib_add_dialog_profile_iv"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/bg_round_8dp_gray300"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_add_dialog_handler"/>

    <!-- 닉네임 -->
    <TextView
        android:id="@+id/lib_add_dialog_nick_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="kanghunsim"
        android:textAppearance="@style/medium20"
        android:textColor="@color/grey_900"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/lib_add_dialog_profile_iv"
        app:layout_constraintTop_toTopOf="@id/lib_add_dialog_profile_iv"
        app:layout_constraintBottom_toBottomOf="@id/lib_add_dialog_profile_iv"/>

    <ImageView
        android:id="@+id/lib_add_dialog_trash_iv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_trash"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/lib_add_dialog_profile_iv"
        app:layout_constraintBottom_toBottomOf="@id/lib_add_dialog_profile_iv"
        app:layout_constraintEnd_toStartOf="@id/lib_add_dialog_modify_iv"/>

    <ImageView
        android:id="@+id/lib_add_dialog_modify_iv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_modify"
        app:layout_constraintTop_toTopOf="@id/lib_add_dialog_profile_iv"
        app:layout_constraintBottom_toBottomOf="@id/lib_add_dialog_profile_iv"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"/>

    <TextView
        android:id="@+id/lib_add_dialog_page_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/regular14"
        android:textColor="@color/grey_500"
        android:layout_marginTop="8dp"
        android:text="살인자의 기억법 p.72"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_add_dialog_profile_iv"/>

    <TextView
        android:id="@+id/lib_add_dialog_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/regular14"
        android:textColor="@color/grey_500"
        android:layout_marginTop="8dp"
        android:text="2025. 12. 05"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toBottomOf="@id/lib_add_dialog_profile_iv"/>


    <ImageView
        android:id="@+id/lib_add_dialog_image_iv"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_round_5dp_gray300"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/lib_add_dialog_page_tv"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"/>

    <TextView
        android:id="@+id/lib_add_dialog_memo_tv"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:text="여기서 개뿔음..."
        android:textAppearance="@style/regular14"
        android:textColor="@color/grey_900"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_round_12dp_gray100"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/lib_add_dialog_image_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 공유 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lib_add_dialog_share_mb"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="공유하기"
        android:textAppearance="@style/regular15"
        android:textColor="@color/grey_100"
        app:cornerRadius="20dp"
        android:background="@color/grey_900"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toBottomOf="@id/lib_add_dialog_memo_tv"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
