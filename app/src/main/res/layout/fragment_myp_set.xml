<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/ui_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.94" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start_inner"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end_inner"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.94" />

        <ImageView
            android:id="@+id/myp_setting_back_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="@id/guideline_start_inner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textAppearance="@style/medium20"
            android:textColor="@color/grey_900"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="알림"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_20dp_white"
                android:paddingVertical="16dp"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/myp_set_bell_iv"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_bell"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/myp_set_push_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="푸시 알림 받기"
                    android:textAppearance="@style/medium15"
                    android:textColor="@color/grey_900"
                    app:layout_constraintStart_toEndOf="@id/myp_set_bell_iv"
                    app:layout_constraintTop_toTopOf="@id/myp_set_bell_iv" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:text="서비스 알림을 받습니다."
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_600"
                    app:layout_constraintStart_toEndOf="@id/myp_set_bell_iv"
                    app:layout_constraintTop_toBottomOf="@id/myp_set_push_tv" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/myp_set_push_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:text="고객센터"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_20dp_white"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/myp_set_notice_iv"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_bell"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/myp_set_notice_tv"
                        android:text="공지사항"
                        android:textAppearance="@style/medium15"
                        android:textColor="@color/grey_900"
                        android:layout_marginStart="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/myp_set_notice_iv"
                        app:layout_constraintTop_toTopOf="@id/myp_set_notice_iv"/>

                    <TextView
                        android:text="새로운 소식을 확인하세요!"
                        android:textAppearance="@style/regular12"
                        android:textColor="@color/grey_600"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="@id/myp_set_notice_tv"
                        app:layout_constraintBottom_toBottomOf="@id/myp_set_notice_iv"/>

                    <ImageView
                        android:id="@+id/myp_set_notice_next_iv"
                        android:src="@drawable/ic_arrow_right"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/myp_set_question_iv"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_question"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/myp_set_question_tv"
                        android:text="문의하기"
                        android:textAppearance="@style/medium15"
                        android:textColor="@color/grey_900"
                        android:layout_marginStart="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/myp_set_question_iv"
                        app:layout_constraintTop_toTopOf="@id/myp_set_question_iv"/>

                    <TextView
                        android:text="서비스 관련 문의는 여기서!"
                        android:textAppearance="@style/regular12"
                        android:textColor="@color/grey_600"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="@id/myp_set_question_tv"
                        app:layout_constraintBottom_toBottomOf="@id/myp_set_question_iv"/>

                    <ImageView
                        android:id="@+id/myp_set_question_next_iv"
                        android:src="@drawable/ic_arrow_right"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp">
                    <ImageView
                        android:id="@+id/myp_set_report_iv"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_notice"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/myp_set_report_tv"
                        android:text="신고하기"
                        android:textAppearance="@style/medium15"
                        android:textColor="@color/grey_900"
                        android:layout_marginStart="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/myp_set_report_iv"
                        app:layout_constraintTop_toTopOf="@id/myp_set_report_iv"/>

                    <TextView
                        android:text="악성 유저를 신고해주세요!"
                        android:textAppearance="@style/regular12"
                        android:textColor="@color/grey_600"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="@id/myp_set_report_tv"
                        app:layout_constraintBottom_toBottomOf="@id/myp_set_report_iv"/>

                    <ImageView
                        android:id="@+id/myp_set_report_next_iv"
                        android:src="@drawable/ic_arrow_right"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>



            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="계정관리"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <TextView
                android:id="@+id/myp_set_logout_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_20dp_white"
                android:paddingVertical="16dp"
                android:paddingHorizontal="12dp"
                android:text="로그아웃"
                android:textAppearance="@style/medium15"
                android:textColor="@color/grey_900"/>

            <TextView
                android:id="@+id/myp_set_quit_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_round_20dp_white"
                android:paddingVertical="16dp"
                android:paddingHorizontal="12dp"
                android:text="회원 탈퇴"
                android:textColor="@color/ui_point_red"
                android:textAppearance="@style/medium15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="이용 약관"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <TextView
                android:id="@+id/myp_service_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_20dp_white"
                android:paddingVertical="16dp"
                android:paddingHorizontal="12dp"
                android:text="서비스 이용 약관"
                android:textAppearance="@style/medium15"
                android:textColor="@color/grey_600"/>

            <TextView
                android:id="@+id/myp_information_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_round_20dp_white"
                android:paddingVertical="16dp"
                android:paddingHorizontal="12dp"
                android:text="개인정보 처리방침"
                android:textColor="@color/grey_600"
                android:textAppearance="@style/medium15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:text="버전 정보"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <TextView
                android:id="@+id/myp_set_version_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_20dp_white"
                android:paddingVertical="16dp"
                android:paddingHorizontal="12dp"
                android:text="v1.0.0"
                android:textAppearance="@style/regular15"
                android:textColor="@color/grey_600"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>