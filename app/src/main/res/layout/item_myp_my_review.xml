<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_round_20dp_white"
    android:elevation="2dp"
    android:padding="16dp">

    <TextView
        android:id="@+id/item_myp_review_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="noshel"
        android:textAppearance="@style/semibold14"
        android:textColor="@color/pre_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text=" 님과의 교환독서"
        android:textAppearance="@style/semibold14"
        android:textColor="@color/grey_900"
        app:layout_constraintStart_toEndOf="@id/item_myp_review_title_tv"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/item_myp_arrow_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/item_myp_review_cover_iv"
        android:layout_width="50dp"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_round_10dp_gray300"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_myp_review_title_tv" />

    <TextView
        android:id="@+id/item_myp_review_book_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        tools:text="괴테는 모든 것을 말했다"
        android:textAppearance="@style/medium14"
        android:textColor="@color/grey_900"
        app:layout_constraintStart_toEndOf="@id/item_myp_review_cover_iv"
        app:layout_constraintTop_toTopOf="@id/item_myp_review_cover_iv" />

    <TextView
        android:id="@+id/item_myp_review_book_author_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="스즈키 유이 (소설)"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_500"
        app:layout_constraintStart_toStartOf="@id/item_myp_review_book_title_tv"
        app:layout_constraintTop_toBottomOf="@id/item_myp_review_book_title_tv" />

    <TextView
        android:id="@+id/item_myp_review_date_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        tools:text="2025. 12. 18 ~ 2026. 01. 12"
        android:textAppearance="@style/regular11"
        android:textColor="@color/grey_400"
        app:layout_constraintStart_toStartOf="@id/item_myp_review_book_title_tv"
        app:layout_constraintTop_toBottomOf="@id/item_myp_review_book_author_tv" />

    <LinearLayout
        android:id="@+id/layout_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_myp_review_cover_iv">

        <TextView
            android:id="@+id/tag1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            tools:text="#글씨가 예뻐요"
            android:textAppearance="@style/regular12"
            android:textColor="@color/ui_main_sub"/>

        <TextView
            android:id="@+id/tag2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            tools:text="#코멘트가 다정해요"
            android:textAppearance="@style/regular12"
            android:textColor="@color/ui_main_sub"/>

        <TextView
            android:id="@+id/tag3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            tools:text="+1"
            android:textAppearance="@style/regular12"
            android:textColor="@color/ui_main_sub"/>
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_tags"
        tools:visibility="visible">

        <TextView
            android:id="@+id/item_myp_review_review_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="도서 후기"
            android:textColor="@color/grey_900"
            android:textAppearance="@style/medium12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/item_myp_review_rate_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/item_myp_review_review_tv">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
        </LinearLayout>

        <TextView
            android:id="@+id/item_myp_my_review_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round_10dp_gray300"
            android:backgroundTint="@color/grey_100"
            android:padding="12dp"
            tools:text="이동진 평론가도 추천한 책이라..."
            android:textColor="@color/grey_900"
            android:textAppearance="@style/regular12"
            app:layout_constraintTop_toBottomOf="@id/item_myp_review_rate_list" />

        <TextView
            android:id="@+id/item_myp_partner_review_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="파트너의 한줄평"
            android:textColor="@color/grey_900"
            android:textAppearance="@style/medium12"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/item_myp_my_review_tv" />


            <TextView
                android:id="@+id/partner_tag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_round_8dp_gray300"
                android:backgroundTint="@color/pre_sub_pale"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp"
                tools:text="#글씨가 예뻐요"
                android:textAppearance="@style/regular12"
                android:textColor="@color/ui_main_sub"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_myp_partner_review_tv"/>

        <TextView
            android:id="@+id/partner_tag2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="8dp"
            tools:text="#코멘트가 다정해요"
            android:textAppearance="@style/regular12"
            android:textColor="@color/ui_main_sub"
            app:layout_constraintStart_toEndOf="@id/partner_tag1"
            app:layout_constraintTop_toBottomOf="@id/item_myp_partner_review_tv"/>

        <TextView
            android:id="@+id/partner_tag3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="8dp"
            tools:text="#코멘트가 재미있어요"
            android:textAppearance="@style/regular12"
            android:textColor="@color/ui_main_sub"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/partner_tag1"/>

        <LinearLayout
            android:id="@+id/item_myp_partner_review_rate_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/partner_tag3">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_star_filled"/>
        </LinearLayout>

        <TextView
            android:id="@+id/item_myp_partner_comment_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round_10dp_gray300"
            android:backgroundTint="@color/grey_100"
            android:padding="12dp"
            tools:text="이동진 평론가도 추천한 책이라..."
            android:textColor="@color/grey_900"
            android:textAppearance="@style/regular12"
            app:layout_constraintTop_toBottomOf="@id/item_myp_partner_review_rate_list" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>