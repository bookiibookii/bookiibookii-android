<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"

android:background="@color/ui_bg">

<androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_percent="0.06" />

<androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline_end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_percent="0.94" />

<!-- 상단 배경 영역 -->
<LinearLayout
    android:id="@+id/lib_top_layout"
    android:layout_width="match_parent"
    android:layout_height="73dp"
    android:orientation="vertical"
    android:background="@color/white"
    app:layout_constraintTop_toTopOf="parent">

    <!-- 내부 콘텐츠 정렬용 ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🔹 내부 전용 가이드라인 (중요) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start_inner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end_inner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.94" />

        <ImageView
            android:id="@+id/lib_search_back_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="@id/guideline_start_inner"
            app:layout_constraintBottom_toBottomOf="parent"

            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/search_input_et"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_20dp_white"
            android:drawableStart="@drawable/ic_lib_search"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:hint="도서명, 저자명 한 줄 평 검색"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:textAppearance="@style/regular14"
            app:layout_constraintStart_toEndOf="@id/lib_search_back_iv"
            app:layout_constraintEnd_toEndOf="@id/guideline_end_inner"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

<TextView
    android:id="@+id/lib_search_count_tv"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="0 권"
    android:layout_marginTop="16dp"
    android:textColor="@color/grey_900"
    android:textAppearance="@style/regular14"
    app:layout_constraintStart_toStartOf="@id/guideline_start"
    app:layout_constraintTop_toBottomOf="@id/lib_top_layout"/>

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/lib_search_result_rv"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="16dp"
    android:clipToPadding="false"
    app:layout_constraintTop_toBottomOf="@id/lib_search_count_tv"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="@id/guideline_start"
    app:layout_constraintEnd_toEndOf="@id/guideline_end" />


</androidx.constraintlayout.widget.ConstraintLayout>
