<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/page">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <ImageView
        android:id="@+id/lib_search_back_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_back"
        android:layout_marginTop="65.5dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/search_input_et"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_round_20dp_white"
        android:drawableStart="@drawable/ic_lib_search"
        android:drawablePadding="8dp"
        android:padding="12dp"
        android:hint="도서명, 저자명 한 줄 평 검색"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:textAppearance="@style/regular14"
        android:layout_marginTop="61.5dp"
        app:layout_constraintStart_toEndOf="@id/lib_search_back_iv"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/lib_search_v"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grey_200"
        android:layout_marginTop="9.5dp"
        app:layout_constraintTop_toBottomOf="@id/search_input_et"/>

    <TextView
        android:id="@+id/lib_search_count_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 권"
        android:layout_marginTop="16dp"
        android:textColor="@color/grey_900"
        android:textAppearance="@style/regular14"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_search_v"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lib_search_result_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/lib_search_count_tv"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        tools:listitem="@layout/item_lib_book"/>

</androidx.constraintlayout.widget.ConstraintLayout>