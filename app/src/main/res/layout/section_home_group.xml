<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/section_exchange_progress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- 헤더: 타이틀 -->
    <TextView
        android:id="@+id/tv_group_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이런 그룹은 어떠세요?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/grey_900"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 새로그침 버튼 -->
    <ImageButton
        android:id="@+id/btn_refresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_refresh"
        android:scaleType="centerInside"
        android:background="@null"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="새로고침"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_group_section_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_group_section_title" />

    <!-- 데이터 있을 때 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_group_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"

        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"

        app:layout_constraintTop_toBottomOf="@id/tv_group_section_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 데이터 없을 때 -->
    <include
        android:id="@+id/include_group_empty"
        layout="@layout/item_home_empty_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="그룹 둘러보기"

        android:visibility="visible"
        tools:visibility="visible"

        android:theme="@style/ThemeOverlay.BookiiBookii.HomeButton.Pre"
        app:layout_constraintTop_toBottomOf="@id/tv_group_section_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>