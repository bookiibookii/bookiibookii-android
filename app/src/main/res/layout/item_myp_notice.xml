<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_round_20dp_white"
    android:padding="16dp">

    <View
        android:id="@+id/item_notice_notice_v"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/pre_main"
        app:layout_constraintStart_toEndOf="@id/item_notice_title_tv"
        app:layout_constraintTop_toTopOf="@id/item_notice_title_tv"
        android:layout_marginStart="8dp"/>

    <TextView
        android:id="@+id/item_notice_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="12월 업데이트 안내"
        android:textAppearance="@style/medium14"
        android:textColor="@color/grey_900"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/item_notice_arrow_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_notice_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="새로운 기능이 추가되었습니다! 독서 카드 꾸미기 기능을 확인해보세요."
        android:textAppearance="@style/regular14"
        android:textColor="@color/grey_900"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_notice_title_tv" />

    <TextView
        android:id="@+id/item_notice_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="5분 전"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_400"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_notice_content" />

    <TextView
        android:id="@+id/item_notice_book_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="책 제목"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_400"
        app:layout_constraintStart_toEndOf="@id/item_notice_date_tv"
        app:layout_constraintTop_toTopOf="@id/item_notice_date_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>