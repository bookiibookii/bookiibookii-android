<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_shipped_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="24dp">

    <View
        android:id="@+id/view_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/grey_200" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="호스트에게 책을 발송했어요!"
        android:textColor="@color/grey_900"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="호스트가 책을 수령하면 상태가 업데이트됩니다."
        android:textColor="@color/grey_500"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tracking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/grey_100"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey_200">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_courier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CJ대한통운"
                android:textColor="@color/grey_900"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tv_tracking_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="1234123412"
                android:textColor="@color/pre_sub"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/pretendard_regular"
                app:layout_constraintStart_toEndOf="@id/tv_courier"
                app:layout_constraintTop_toTopOf="@id/tv_courier"
                app:layout_constraintBottom_toBottomOf="@id/tv_courier"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_status"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="수령 전"
                android:textSize="12sp"
                android:textStyle="bold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="false"
                android:focusable="false"
                android:enabled="false"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/pre_sub_pale"
                android:textColor="@color/pre_sub"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_finish"
        style="@style/Widget.BookiiBookii.DirectButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="수령 인증 확인하기"
        android:textSize="16sp" />

</LinearLayout>
