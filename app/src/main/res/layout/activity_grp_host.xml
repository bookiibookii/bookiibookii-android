<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/act_grp_ho_guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.08" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/act_grp_ho_guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.92" />

        <ImageView
            android:id="@+id/act_grp_ho_dashBoard_Iv"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_grp_dashboard_border"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/act_grp_ho_back_Iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_button"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_dashBoard_Iv" />

        <ImageView
            android:id="@+id/act_grp_ho_more_Iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_more_btn"
            app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_dashBoard_Iv" />

        <TextView
            android:id="@+id/act_grp_ho_main_title_Tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/pretendard_variable"
            android:textSize="20sp"
            android:textColor="@color/grey_900"
            android:text="괴테는 모든 것을 말했다"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_back_Iv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintEnd_toStartOf="@id/act_grp_ho_more_Iv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_dashBoard_Iv" />

        <include
            android:id="@+id/act_grp_ho_included_item"
            layout="@layout/item_grp_card_manage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
            app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end" />

        <ImageView
            android:id="@+id/acr_grp_ho_intro_Iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_round_20dp_white"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="@id/bottom_padding_space1"
            app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_included_item" />

        <TextView
            android:id="@+id/act_grp_ho_intro_title_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="그룹 소개"
            android:textColor="@color/grey_900"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/acr_grp_ho_intro_Iv"
            app:layout_constraintTop_toTopOf="@id/acr_grp_ho_intro_Iv" />

        <View
            android:id="@+id/divider_line_intro"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/grey_200"
            app:layout_constraintEnd_toEndOf="@id/act_grp_ho_intro_cont_Tv"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_intro_title_Tv"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_intro_title_Tv" />

        <TextView
            android:id="@+id/act_grp_ho_intro_cont_Tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/pretendard_variable"
            android:textColor="@color/grey_500"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/acr_grp_ho_intro_Iv"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_intro_title_Tv"
            app:layout_constraintTop_toBottomOf="@id/divider_line_intro"
            android:text="안녕하세요. 재미있게 책 완독하실 분 구해요^^책에 마음껏 메모하셔도 됩니다. 재미있는 코멘트 많이 남겨주세요~" />

        <Space
            android:id="@+id/bottom_padding_space1"
            android:layout_width="0dp"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_intro_cont_Tv"
            app:layout_constraintStart_toStartOf="@id/acr_grp_ho_intro_Iv" />

        <ImageView
            android:id="@+id/acr_grp_ho_member_Iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_round_20dp_white"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="@id/bottom_padding_space2"
            app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
            app:layout_constraintTop_toBottomOf="@id/acr_grp_ho_intro_Iv" />

        <TextView
            android:id="@+id/act_grp_ho_member_title_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="참여 멤버"
            android:textColor="@color/grey_900"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/acr_grp_ho_member_Iv"
            app:layout_constraintTop_toTopOf="@id/acr_grp_ho_member_Iv" />

        <TextView
            android:id="@+id/act_grp_ho_member_status1_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="1"
            android:textColor="@color/pre_main"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

        <TextView
            android:id="@+id/act_grp_ho_member_status2_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="/"
            android:textColor="@color/pre_main"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_status1_Tv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

        <TextView
            android:id="@+id/act_grp_ho_member_status3_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="2"
            android:textColor="@color/pre_main"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_status2_Tv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

        <TextView
            android:id="@+id/act_grp_ho_member_status4_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="명"
            android:textColor="@color/pre_main"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_status3_Tv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

        <View
            android:id="@+id/divider_line_member"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@color/grey_200"
            app:layout_constraintEnd_toEndOf="@id/acr_grp_ho_member_Iv"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_member_title_Tv" />

        <ImageView
            android:id="@+id/act_grp_ho_member_profile1_Iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_profile"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintTop_toBottomOf="@id/divider_line_member" />

        <TextView
            android:id="@+id/act_grp_ho_member_nickname1_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/pretendard_variable"
            android:textSize="14sp"
            android:textColor="@color/grey_900"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_profile1_Iv"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_profile1_Iv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_profile1_Iv"
            android:text="noshel" />

        <com.google.android.material.chip.Chip
            android:id="@+id/act_grp_ho_host_Cp"
            style="@style/Widget.App.Chip.host"
            android:layout_width="wrap_content"
            android:layout_height="23dp"
            android:layout_marginStart="8dp"
            android:text="HOST"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_nickname1_Tv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_nickname1_Tv" />

        <ImageView
            android:id="@+id/act_grp_ho_member_profile2_Iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/grey_200"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            app:layout_constraintStart_toStartOf="@id/act_grp_ho_member_title_Tv"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_member_profile1_Iv" />

        <TextView
            android:id="@+id/act_grp_ho_member_nickname2_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/pretendard_variable"
            android:textSize="14sp"
            android:textColor="@color/grey_600"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_profile2_Iv"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_profile2_Iv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_profile2_Iv"
            android:text="모집중" />

        <Space
            android:id="@+id/bottom_padding_space2"
            android:layout_width="0dp"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@id/act_grp_ho_member_profile2_Iv"
            app:layout_constraintStart_toStartOf="@id/acr_grp_ho_member_Iv" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/persistent_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:background="@drawable/bg_bottom_sheet_top_round"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="170dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/grp_mg_bottom_sheet_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@color/grey_200"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/grp_mg_bottom_sheet_title_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="댓글"
            android:textColor="@color/grey_900"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/grp_mg_bottom_sheet_handle" />

        <TextView
            android:id="@+id/grp_mg_bottom_sheet_num_title_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="3"
            android:textColor="@color/pre_main"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintStart_toEndOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintTop_toTopOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <ImageView
            android:id="@+id/grp_mg_bottom_sheet_reload_Iv"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_reload"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <View
            android:id="@+id/divider_line1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            android:background="@color/grey_200"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grp_mg_bottom_sheet_info_Rv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_line1"
            tools:listitem="@layout/item_grp_chat_card" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_area_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:elevation="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_input_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_grp_search_input"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_lock"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/grp_mg_bottom_sheet_input_Et"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@null"
                android:fontFamily="@font/pretendard_variable"
                android:hint="텍스트 입력 전"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey_400"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/grp_mg_bottom_sheet_send_Iv"
                app:layout_constraintStart_toEndOf="@id/iv_lock"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/grp_mg_bottom_sheet_send_Iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:padding="4dp"
                android:src="@drawable/ic_send"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>