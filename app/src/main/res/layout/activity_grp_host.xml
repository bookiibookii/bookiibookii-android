<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">
        <androidx.constraintlayout.widget.Guideline
        android:id="@+id/header_guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/header_guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.94" />

        <ImageView
            android:id="@+id/act_grp_ho_dashBoard_Iv"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/act_grp_ho_back_Iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="@id/header_guideline_start"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_dashBoard_Iv" />

        <ImageView
            android:id="@+id/act_grp_ho_more_Iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_meetball"
            app:layout_constraintEnd_toEndOf="@id/header_guideline_end"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_dashBoard_Iv" />

        <TextView
            android:id="@+id/act_grp_ho_main_title_Tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/pretendard_variable"
            android:textSize="20sp"
            android:textColor="@color/grey_900"
            app:layout_constraintStart_toEndOf="@id/act_grp_ho_back_Iv"
            app:layout_constraintTop_toTopOf="@id/act_grp_ho_dashBoard_Iv"
            app:layout_constraintEnd_toStartOf="@id/act_grp_ho_more_Iv"
            app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_dashBoard_Iv"
            tools:text="괴테는 모든 것을 말했다" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="68dp"
        android:fillViewport="true"
        android:paddingBottom="180dp"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/act_grp_ho_guideline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.06" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/act_grp_ho_guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.94" />

            <include
                android:id="@+id/act_grp_ho_included_item"
                layout="@layout/item_grp_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end" />

            <ImageView
                android:id="@+id/acr_grp_ho_intro_Iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:paddingBottom="20dp"
                app:layout_constraintBottom_toBottomOf="@id/bottom_padding_space1"
                app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/act_grp_ho_included_item" />

            <TextView
                android:id="@+id/act_grp_ho_intro_title_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/pretendard_variable"
                android:text="그룹 소개"
                android:textColor="@color/grey_900"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/acr_grp_ho_intro_Iv"
                app:layout_constraintTop_toTopOf="@id/acr_grp_ho_intro_Iv" />

            <View
                android:id="@+id/divider_line_intro"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@id/act_grp_ho_intro_cont_Tv"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_intro_title_Tv"
                app:layout_constraintTop_toBottomOf="@id/act_grp_ho_intro_title_Tv" />

            <TextView
                android:id="@+id/act_grp_ho_intro_cont_Tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/pretendard_variable"
                android:textColor="@color/grey_700"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="@id/acr_grp_ho_intro_Iv"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_intro_title_Tv"
                app:layout_constraintTop_toBottomOf="@id/divider_line_intro"
                tools:text="안녕하세요. 재미있게 책 완독하실 분 구해요" />

            <LinearLayout
                android:id="@+id/act_grp_ho_region_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_intro_cont_Tv"
                app:layout_constraintEnd_toEndOf="@id/act_grp_ho_intro_cont_Tv"
                app:layout_constraintTop_toBottomOf="@id/act_grp_ho_intro_cont_Tv">

                <TextView
                    android:id="@+id/act_grp_ho_intro_hope_region_Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_variable"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="교환 희망 장소"
                    android:textColor="@color/grey_500"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/act_grp_ho_intro_real_region_Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/pretendard_variable"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    tools:text="망원동 주민센터 앞"
                    android:textColor="@color/grey_500"
                    android:textSize="14sp" />
            </LinearLayout>

            <Space
                android:id="@+id/bottom_padding_space1"
                android:layout_width="0dp"
                android:layout_height="20dp"
                app:layout_constraintTop_toBottomOf="@id/act_grp_ho_region_layout"
                app:layout_constraintStart_toStartOf="@id/acr_grp_ho_intro_Iv" />

            <ImageView
                android:id="@+id/acr_grp_ho_member_Iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:paddingBottom="20dp"
                app:layout_constraintBottom_toBottomOf="@id/bottom_padding_space2"
                app:layout_constraintEnd_toEndOf="@id/act_grp_ho_guideline_end"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/acr_grp_ho_intro_Iv" />

            <TextView
                android:id="@+id/act_grp_ho_member_title_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/pretendard_variable"
                android:text="참여 멤버"
                android:textColor="@color/grey_900"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/acr_grp_ho_member_Iv"
                app:layout_constraintTop_toTopOf="@id/acr_grp_ho_member_Iv" />

            <TextView
                android:id="@+id/act_grp_ho_member_status1_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/pretendard_variable"
                tools:text="1"
                android:textColor="@color/ui_main"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

            <TextView
                android:id="@+id/act_grp_ho_member_status2_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:fontFamily="@font/pretendard_variable"
                android:text="/"
                android:textColor="@color/ui_main"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_status1_Tv"
                app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

            <TextView
                android:id="@+id/act_grp_ho_member_status3_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:fontFamily="@font/pretendard_variable"
                tools:text="2"
                android:textColor="@color/ui_main"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_status2_Tv"
                app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

            <TextView
                android:id="@+id/act_grp_ho_member_status4_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/pretendard_variable"
                android:text="명"
                android:textColor="@color/ui_main"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/act_grp_ho_member_status3_Tv"
                app:layout_constraintTop_toTopOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintBottom_toBottomOf="@id/act_grp_ho_member_title_Tv" />

            <View
                android:id="@+id/divider_line_member"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="@id/acr_grp_ho_member_Iv"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintTop_toBottomOf="@id/act_grp_ho_member_title_Tv" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/act_grp_ho_member_Rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/acr_grp_ho_member_Iv"
                app:layout_constraintStart_toStartOf="@id/act_grp_ho_member_title_Tv"
                app:layout_constraintTop_toBottomOf="@id/divider_line_member"
                app:layout_constraintBottom_toBottomOf="@id/bottom_padding_space2"
                tools:listitem="@layout/item_grp_member" />

            <Space
                android:id="@+id/bottom_padding_space2"
                android:layout_width="0dp"
                android:layout_height="20dp"
                app:layout_constraintTop_toBottomOf="@id/act_grp_ho_member_Rv"
                app:layout_constraintStart_toStartOf="@id/acr_grp_ho_member_Iv" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/persistentBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="650dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/grp_mg_bottom_sheet_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/grp_mg_bottom_sheet_back_Iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <TextView
            android:id="@+id/grp_mg_bottom_sheet_title_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_goneMarginStart="24dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_variable"
            android:text="댓글"
            android:textColor="@color/grey_900"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@id/grp_mg_bottom_sheet_back_Iv"
            app:layout_constraintTop_toBottomOf="@id/grp_mg_bottom_sheet_handle" />
        <TextView
            android:id="@+id/grp_mg_bottom_sheet_num_title_Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/pretendard_variable"
            tools:text="3"
            android:textColor="@color/ui_main"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintStart_toEndOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintTop_toTopOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <ImageView
            android:id="@+id/grp_mg_bottom_sheet_reload_Iv"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_reload"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <View
            android:id="@+id/divider_line1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/grp_mg_bottom_sheet_title_Tv" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grp_mg_bottom_sheet_info_Rv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_line1"
            tools:listitem="@layout/item_grp_chat_card" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_area_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_input_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_lock"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/grp_mg_bottom_sheet_input_Et"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:fontFamily="@font/pretendard_variable"
                android:hint="텍스트 입력 전"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey_400"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/grp_mg_bottom_sheet_send_Iv"
                app:layout_constraintStart_toEndOf="@id/iv_lock"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/grp_mg_bottom_sheet_send_Iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:padding="4dp"
                android:src="@drawable/ic_up"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>