<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_reading_done_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="24dp">

    <View
        android:id="@+id/view_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/grey_200" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="게스트가 책을 다 읽었어요!"
        android:textColor="@color/grey_900"
        android:textSize="20sp"
        android:fontFamily="@font/pretendard_medium" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="게스트가 운송장을 등록하면 상태가 업데이트됩니다."
        android:textColor="@color/grey_700"
        android:textSize="13sp"
        android:fontFamily="@font/pretendard_regular" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_card"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:text="독서카드 확인하러 가기"
        android:textColor="@color/grey_100"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/pretendard_medium"
        android:backgroundTint="@color/grey_900"
        app:cornerRadius="16dp" />

</LinearLayout>
