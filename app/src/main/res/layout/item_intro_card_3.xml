<?xml version="1.0" encoding="utf-8"?>
<!-- 카드 3: 후기/뱃지 카드 (소중한 후기로 가꾸는 나에게 꼭 맞는 독서 파트너와의 안남) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 별점 5개 (크게) -->
            <!-- TODO: 아래 별 5개 src 원본 @drawable/ic_star_filled -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:color/transparent" />
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:color/transparent" android:layout_marginStart="3dp" />
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:color/transparent" android:layout_marginStart="3dp" />
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:color/transparent" android:layout_marginStart="3dp" />
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:color/transparent" android:layout_marginStart="3dp" />
            </LinearLayout>

            <!-- 뱃지 행 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <!-- TODO: background 원본 @drawable/bg_round_20dp_white_stroke_1dp_gray200 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="친절하고 매너가 좋아요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_700"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="12dp" />

                <!-- TODO: background 원본 @drawable/bg_round_20dp_main_pale_stroke_1dp_main -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="글씨가 예뻐요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/ui_main"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <!-- 뱃지 행 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- TODO: background 원본 @drawable/bg_round_20dp_white_stroke_1dp_gray200 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="코멘트가 다정해요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_700"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="6dp" />

                <!-- TODO: background 원본 @drawable/bg_round_20dp_white_stroke_1dp_gray200 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="책에 대한 인사이트가 넘쳐요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_700"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <!-- 뱃지 행 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- TODO: background 원본 @drawable/bg_round_20dp_white_stroke_1dp_gray200 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="책을 빠르게 보내줬어요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_700"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="6dp" />

                <!-- TODO: background 원본 @drawable/bg_round_20dp_main_pale_stroke_1dp_main -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="코멘트가 재미있어요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/ui_main"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <!-- 뱃지 행 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- TODO: background 원본 @drawable/bg_round_20dp_white_stroke_1dp_gray200 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="책을 깨끗하고 꼼꼼하게 읽어요"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_700"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
