<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="24dp"
    android:background="@drawable/bg_round_24dp_white">

    <TextView
        android:id="@+id/share_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="공유하기"
        android:textAppearance="@style/medium20"
        android:textColor="@color/grey_900"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/share_close_iv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <FrameLayout
        android:id="@+id/parent_share_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/share_tv">

        <androidx.cardview.widget.CardView
            android:id="@+id/type_a_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:visibility="gone"> <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/share_image_a"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_round_top_20dp_white"
                app:layout_constraintTop_toTopOf="parent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_round_5dp_red105"
                android:backgroundTint="@color/pre_main_pale"
                app:layout_constraintStart_toStartOf="@id/share_image_a"
                app:layout_constraintTop_toTopOf="@id/share_image_a">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_b_orange"/>
                <TextView
                    android:id="@+id/share_title_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/medium14"
                    android:textColor="@color/pre_main"
                    android:layout_marginStart="6dp"
                    android:text="나는 당신을 편애합니다."/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:paddingHorizontal="20dp"
                android:orientation="vertical"
                android:background="@color/white"
                app:layout_constraintTop_toBottomOf="@id/share_image_a">
                <TextView
                    android:id="@+id/share_content_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:textAppearance="@style/regular14"
                    android:textColor="@color/grey_800"
                    android:text="책을 쓰지 않고 한 우물만 팠다면..." />
                <TextView
                    android:id="@+id/share_author_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/regular14"
                    android:textColor="@color/grey_400"
                    android:gravity="end"
                    android:text="foryxxng" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/type_b_layout"
            android:layout_width="match_parent"
            android:layout_height="370dp"
            android:padding="20dp"
            android:visibility="visible"> <ImageView
            android:id="@+id/share_image_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_round_20dp_white" />

            <TextView
                android:id="@+id/share_title_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나는 당신을 편애합니다"
                android:textAppearance="@style/medium11"
                android:textColor="@color/pre_main"
                app:layout_constraintStart_toStartOf="@id/share_image_b"
                app:layout_constraintTop_toTopOf="@id/share_image_b"/>

            <TextView
                android:id="@+id/share_content_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="책을 쓰지 않고 한 우물만 팠다면..."
                app:layout_constraintTop_toBottomOf="@id/share_title_b"
                app:layout_constraintStart_toStartOf="@id/share_title_b"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/share_author_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by. foryxxng"
                android:textAppearance="@style/regular14"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/share_image_b"
                app:layout_constraintStart_toStartOf="@id/share_image_b"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_b_white"
                app:layout_constraintBottom_toBottomOf="@id/share_image_b"
                app:layout_constraintEnd_toEndOf="@id/share_image_b"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/color_selection_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/parent_share_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:id="@+id/btn_type_a"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ic_ver1" />
        <View
            android:id="@+id/btn_type_b"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_ver2" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grey_100"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/color_selection_layout"/>

    <LinearLayout
        android:id="@+id/share_sns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:weightSum="4"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/share_insta"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_insta"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="인스타그램"
                android:textAppearance="@style/regular12"
                android:textColor="@color/grey_900"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/share_kakao"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_kakao"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="카카오"
                android:textAppearance="@style/regular12"
                android:textColor="@color/grey_900"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/share_x"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_x"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="X"
                android:textAppearance="@style/regular12"
                android:textColor="@color/grey_900"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/share_link"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_copy_link"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="링크 복사"
                android:textAppearance="@style/regular12"
                android:textColor="@color/grey_900"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>