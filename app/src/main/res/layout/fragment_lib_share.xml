<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_24dp_white"
    android:padding="24dp">

    <TextView
        android:id="@+id/share_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="공유하기"
        android:textColor="@color/grey_900"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/share_close_iv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/parent_share_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/share_tv">

        <androidx.cardview.widget.CardView
            android:id="@+id/type_a_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/share_image_a"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_round_top_20dp_white"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/share_title_container_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_round_5dp_red105"
                    android:backgroundTint="#FFF3E0"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_b_orange" />

                    <TextView
                        android:id="@+id/share_title_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="책 제목 로딩중..."
                        android:textAppearance="@style/medium14"
                        android:textColor="@color/pre_main"/>
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/share_bottom_container_a"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-20dp"
                    app:layout_constraintStart_toStartOf="@id/share_image_a"
                    app:layout_constraintEnd_toEndOf="@id/share_image_a"
                    android:background="@drawable/bg_round_20dp_white_bottom"
                    app:layout_constraintTop_toBottomOf="@id/share_image_a"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/share_content_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="30dp"
                        android:ellipsize="end"
                        android:maxLines="4"
                        android:text=""
                        android:textColor="@color/grey_800"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_author_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="24dp"
                        android:text=""
                        android:textColor="@color/grey_400"
                        android:textAppearance="@style/regular14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/share_content_a"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/type_b_card"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/share_image_b"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_round_20dp_white" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_gradient_white_top"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/share_title_container_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/share_title_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="280dp"
                        android:maxLines="1"
                        android:text="책 제목 로딩중..."
                        android:textAppearance="@style/medium11"
                        android:textColor="@color/pre_main"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/share_content_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="30dp"
                    android:text=""
                    android:textColor="@color/grey_800"
                    android:textAppearance="@style/regular14"
                    app:layout_constraintStart_toStartOf="@id/share_title_container_b"
                    app:layout_constraintTop_toBottomOf="@id/share_title_container_b"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/share_author_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="24dp"
                    android:text=""
                    android:textColor="@color/white"
                    android:textAppearance="@style/regular14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="24dp"
                    android:src="@drawable/ic_b_white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/color_selection_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parent_share_container">

        <View
            android:id="@+id/btn_type_a"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ic_ver1" />

        <View
            android:id="@+id/btn_type_b"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_ver2" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/color_selection_layout" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/share_sns"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <LinearLayout
            android:id="@+id/sns_item_insta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sns_item_kakao"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/share_insta"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_insta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="인스타그램"
                android:textColor="@color/grey_900"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sns_item_kakao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/sns_item_insta"
            app:layout_constraintEnd_toStartOf="@id/sns_item_x"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/share_kakao"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_kakao" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="카카오톡"
                android:textColor="@color/grey_900"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sns_item_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/sns_item_kakao"
            app:layout_constraintEnd_toStartOf="@id/sns_item_link"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/share_x"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_x" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="X"
                android:textColor="@color/grey_900"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sns_item_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/sns_item_x"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/share_link"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_copy_link" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="링크 복사"
                android:textColor="@color/grey_900"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>