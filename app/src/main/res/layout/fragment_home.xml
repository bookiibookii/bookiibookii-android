<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_bg">

    <!-- 헤더 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_person_fill"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="탐색"
            android:textSize="20sp"
            android:textColor="@color/grey_900"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnAlert"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_alert_32"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/grey_200"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 스크롤 콘텐츠 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 알림보드 섹션 -->
            <LinearLayout
                android:id="@+id/sectionNoticeboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- 인사말 1줄: "안녕하세요, username" (username은 orange) -->
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="안녕하세요,"
                    android:textSize="24sp"
                    android:textColor="@color/grey_800"
                    android:fontFamily="@font/pretendard_medium" />

                <!-- 인사말 2줄 -->
                <TextView
                    android:id="@+id/tvGreetingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="책과 함께 하는 편안한 오후 되세요"
                    android:textSize="24sp"
                    android:textColor="@color/grey_900"
                    android:fontFamily="@font/pretendard_medium" />

                <Space android:layout_width="match_parent" android:layout_height="16dp"/>

                <!-- 검색바 + 그룹 생성 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 검색바 -->
                    <LinearLayout
                        android:id="@+id/searchBar"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_grey200_stroke_r30"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvSearchHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="그룹을 검색해보세요"
                            android:textSize="16sp"
                            android:textColor="@color/grey_500"
                            android:fontFamily="@font/pretendard_regular"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:id="@+id/ivSearch"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_grey300_circle"
                            android:src="@drawable/ic_search"
                            app:tint="@color/white"
                            android:padding="6dp"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <Space android:layout_width="8dp" android:layout_height="match_parent"/>

                    <!-- 그룹 생성 버튼 -->
                    <TextView
                        android:id="@+id/btnCreateGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_main_r999"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center"
                        android:text="그룹 생성"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/pretendard_regular" />

                </LinearLayout>

            </LinearLayout>

            <!-- 탭 바 -->
            <LinearLayout
                android:id="@+id/tabBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white">

                <!-- 추천 탭 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabRecommend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp"
                        android:text="추천"
                        android:textSize="18sp"
                        android:textColor="@color/ui_main"
                        android:fontFamily="@font/pretendard_medium" />

                    <View
                        android:id="@+id/tabIndicatorRecommend"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/ui_main" />

                </LinearLayout>

                <!-- 전체 탭 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp"
                        android:text="전체"
                        android:textSize="18sp"
                        android:textColor="@color/grey_400"
                        android:fontFamily="@font/pretendard_medium" />

                    <View
                        android:id="@+id/tabIndicatorAll"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/transparent" />

                </LinearLayout>

                <!-- 신청한 그룹 탭 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabApplied"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp"
                        android:text="신청한 그룹"
                        android:textSize="18sp"
                        android:textColor="@color/grey_400"
                        android:fontFamily="@font/pretendard_medium" />

                    <View
                        android:id="@+id/tabIndicatorApplied"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/transparent" />

                </LinearLayout>

            </LinearLayout>

            <!-- 탭 하단 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_200" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
