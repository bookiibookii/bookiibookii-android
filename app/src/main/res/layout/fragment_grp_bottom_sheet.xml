<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top_round"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/grp_bottom_sheet_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/grp_bottom_sheet_title_Tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/pretendard_variable"
        android:text="분야별"
        android:textColor="@color/grey_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grp_bottom_sheet_handle" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_economy"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="4dp"
        android:checked="true"
        android:gravity="center"
        android:text="경제/경영"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintEnd_toStartOf="@id/chip_tech"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grp_bottom_sheet_title_Tv" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_tech"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:gravity="center"
        android:text="기술/과학"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/chip_economy"
        app:layout_constraintEnd_toStartOf="@id/chip_novel"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/chip_economy"
        app:layout_constraintTop_toTopOf="@id/chip_economy" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_novel"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="소설"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/chip_economy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.8"
        app:layout_constraintStart_toEndOf="@id/chip_tech"
        app:layout_constraintTop_toTopOf="@id/chip_economy" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_poem"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:text="시"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintEnd_toStartOf="@id/chip_essay"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chip_economy" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_essay"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:gravity="center"
        android:text="에세이"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/chip_poem"
        app:layout_constraintEnd_toStartOf="@id/chip_art"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/chip_poem"
        app:layout_constraintTop_toTopOf="@id/chip_poem" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_art"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="예술/문화"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/chip_poem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/chip_essay"
        app:layout_constraintTop_toTopOf="@id/chip_poem" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_humanities"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:text="인문학"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintEnd_toStartOf="@id/chip_self"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chip_poem" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_self"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:gravity="center"
        android:text="자기계발"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/chip_humanities"
        app:layout_constraintEnd_toStartOf="@id/chip_politics"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/chip_humanities"
        app:layout_constraintTop_toTopOf="@id/chip_humanities" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_politics"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="정치/사회"
        android:textAlignment="center"
        android:textColor="@color/selector_chip_category_stroke"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="@color/selector_chip_category_bg"
        app:chipCornerRadius="30dp"
        app:chipStrokeColor="@color/selector_chip_category_stroke"
        app:chipStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/chip_humanities"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/chip_self"
        app:layout_constraintTop_toTopOf="@id/chip_humanities" />

</androidx.constraintlayout.widget.ConstraintLayout>