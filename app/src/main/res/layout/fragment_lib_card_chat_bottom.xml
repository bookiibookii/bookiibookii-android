<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_bottom_sheet_round">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />

    <View
        android:id="@+id/lib_dialog_handler"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/ic_handlebar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/lib_card_chat_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/medium20"
        android:textColor="@color/grey_900"
        android:layout_marginTop="20dp"
        android:text="댓글"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_dialog_handler"/>

    <TextView
        android:id="@+id/lib_card_chat_total_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3"
        android:textAppearance="@style/regular14"
        android:textColor="@color/pre_main"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/lib_card_chat_tv"
        app:layout_constraintTop_toTopOf="@id/lib_card_chat_tv"
        app:layout_constraintBottom_toBottomOf="@id/lib_card_chat_tv"/>

    <ImageView
        android:id="@+id/lib_card_loading_iv"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_reload"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toTopOf="@id/lib_card_chat_tv"
        app:layout_constraintBottom_toBottomOf="@id/lib_card_chat_tv"/>

    <View
        android:id="@+id/lib_line_v"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grey_200"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/lib_card_chat_tv"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lib_card_chat_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/lib_line_v"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintBottom_toTopOf="@id/et_input"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="12dp"
        tools:listitem="@layout/item_lib_card_chat"/>

    <EditText
        android:id="@+id/et_input"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_round_20dp_white"
        android:hint="텍스트 입력 전"
        android:textAppearance="@style/regular15"
        android:textColor="@color/grey_500"
        android:inputType="text"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        android:paddingStart="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>



    <ImageView
        android:id="@+id/btn_send"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_upload_chat"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="@id/et_input"
        app:layout_constraintTop_toTopOf="@id/et_input"
        app:layout_constraintBottom_toBottomOf="@id/et_input"/>

</androidx.constraintlayout.widget.ConstraintLayout>