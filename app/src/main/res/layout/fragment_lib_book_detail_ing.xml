<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/ui_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />

    <LinearLayout
        android:id="@+id/lib_top_layout"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        android:orientation="vertical"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_start_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.06" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_end_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.94" />

            <ImageView
                android:id="@+id/lib_detail_back_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/guideline_start_inner"/>

            <TextView
                android:id="@+id/lib_detail_title_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/medium20"
                android:textColor="@color/grey_900"
                android:text="괴테는 모든 것을 말했다"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintStart_toEndOf="@id/lib_detail_back_iv"
                app:layout_constraintEnd_toStartOf="@id/lib_detail_more_iv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                android:id="@+id/lib_detail_more_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_more"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guideline_end_inner"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lib_detail_cv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/lib_top_layout"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/card_guideline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.05" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/card_guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.95" />

            <ImageView
                android:id="@+id/lib_detail_image_iv"
                android:layout_width="92dp"
                android:layout_height="118dp"
                android:src="@drawable/bg_round_20dp_gray200"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@id/card_guideline_start"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                android:id="@+id/lib_detail_profile_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/bg_round_10dp_gray300"
                android:layout_marginTop="16dp"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toEndOf="@id/lib_detail_image_iv"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/lib_detail_profile_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/medium12"
                android:textColor="@color/grey_700"
                android:text="noshel"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@id/lib_detail_profile_iv"
                app:layout_constraintTop_toTopOf="@id/lib_detail_profile_iv"
                app:layout_constraintBottom_toBottomOf="@id/lib_detail_profile_iv"/>

            <HorizontalScrollView
                android:id="@+id/lib_detail_book_title_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginStart="14dp"
                android:scrollbars="none"
                app:layout_constraintStart_toEndOf="@id/lib_detail_image_iv"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end"
                app:layout_constraintTop_toBottomOf="@id/lib_detail_profile_iv">

                <TextView
                    android:id="@+id/lib_detail_book_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/regular14"
                    android:textColor="@color/grey_900"
                    android:text="괴테는 모든 것을 말했다."
                    android:maxLines="1"
                    android:scrollHorizontally="true"/>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/lib_detail_book_author_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="14dp"
                android:scrollbars="none"
                app:layout_constraintStart_toEndOf="@id/lib_detail_image_iv"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end"
                app:layout_constraintTop_toBottomOf="@id/lib_detail_book_title_scroll">

                <TextView
                    android:id="@+id/lib_detail_book_author_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/regular12"
                    android:textColor="@color/grey_500"
                    android:text="스즈키 유이 (소설)"
                    android:maxLines="1"
                    android:scrollHorizontally="true"/>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/lib_detail_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/regular11"
                android:textColor="@color/grey_400"
                android:text="2025. 12. 18.~"
                android:layout_marginStart="14dp"
                android:layout_marginTop="11dp"
                app:layout_constraintBottom_toBottomOf="@id/lib_detail_image_iv"
                app:layout_constraintStart_toEndOf="@id/lib_detail_image_iv"/>

            <TextView
                android:id="@+id/my_percent_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/medium11"
                android:text="나의 독서율"
                android:textColor="@color/pre_main"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@id/card_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/lib_detail_date_tv"/>

            <TextView
                android:id="@+id/my_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/medium11"
                android:text="79%"
                android:textColor="@color/pre_main"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end"
                app:layout_constraintTop_toBottomOf="@id/lib_detail_date_tv"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/progress_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/my_percent"
                app:layout_constraintStart_toStartOf="@id/card_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end">

                <ProgressBar
                    android:id="@+id/reading_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:secondaryProgress="0"
                    android:progressDrawable="@drawable/bg_reading_progress"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_my_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.0" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_group_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.0" />

                <View
                    android:id="@+id/my_progress_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/grey_100"
                    android:translationX="-1dp"
                    app:layout_constraintEnd_toEndOf="@id/guideline_my_progress"
                    app:layout_constraintTop_toTopOf="@id/reading_progress_bar"
                    app:layout_constraintBottom_toBottomOf="@id/reading_progress_bar"/>

                <View
                    android:id="@+id/group_avg_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/grey_100"
                    android:translationX="-1dp"
                    app:layout_constraintEnd_toEndOf="@id/guideline_group_progress"
                    app:layout_constraintTop_toTopOf="@id/reading_progress_bar"
                    app:layout_constraintBottom_toBottomOf="@id/reading_progress_bar"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/avg_percent_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/medium11"
                android:text="그룹 평균 독서율"
                android:textColor="@color/grey_900"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@id/card_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/progress_layout"/>

            <TextView
                android:id="@+id/avg_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/medium11"
                android:text="79%"
                android:textColor="@color/grey_900"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end"
                app:layout_constraintTop_toBottomOf="@id/progress_layout"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/lib_write_review_btn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_round_20dp_gray900"
                android:backgroundTint="@color/pre_main_pale"
                android:enabled="true"
                android:visibility="gone"
                android:text="후기 작성하기"
                android:textAppearance="@style/regular15"
                android:textColor="@color/pre_main"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end"
                app:layout_constraintStart_toStartOf="@id/card_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/avg_percent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/lib_write_done_btn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_round_20dp_gray900"
                android:backgroundTint="@color/pre_main_pale"
                android:enabled="true"
                android:visibility="visible"
                android:text="다 읽었어요"
                android:textAppearance="@style/regular15"
                android:textColor="@color/pre_main"
                app:layout_constraintEnd_toEndOf="@id/card_guideline_end"
                app:layout_constraintStart_toStartOf="@id/card_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/avg_percent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/lib_detail_total_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/grey_700"
        android:textAppearance="@style/regular14"
        android:layout_marginTop="12dp"
        android:text="16개"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/lib_detail_cv"/>
    <TextView
        android:id="@+id/lib_detail_lately_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/grey_700"
        android:textAppearance="@style/medium14"
        android:layout_marginTop="12dp"
        android:text="최신순"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/lib_detail_guid_tv"
        app:layout_constraintTop_toBottomOf="@id/lib_detail_cv"/>
    <TextView
        android:id="@+id/lib_detail_guid_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/grey_500"
        android:textAppearance="@style/regular14"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:text="|"
        app:layout_constraintEnd_toStartOf="@id/lib_detail_page_tv"
        app:layout_constraintTop_toBottomOf="@id/lib_detail_cv"/>
    <TextView
        android:id="@+id/lib_detail_page_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/grey_500"
        android:textAppearance="@style/regular14"
        android:layout_marginTop="12dp"
        android:text="페이지순"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toBottomOf="@id/lib_detail_cv"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lib_review_list_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toBottomOf="@id/lib_detail_total_tv"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_lib_detail_review"
        />

    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toBottomOf="@id/lib_detail_cv"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_round_24dp_white"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아직 독서카드가 없어요"
            android:textAppearance="@style/medium16"
            android:textColor="@color/grey_900"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="마음에 드는 내용을 기록으로 남겨요."
            android:textAppearance="@style/regular14"
            android:textColor="@color/grey_600"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_data_exist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="lib_detail_total_tv, lib_detail_lately_tv, lib_detail_guid_tv, lib_detail_page_tv, lib_review_list_rv"
        android:visibility="visible"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/lib_review_add_btn"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:visibility="gone"
        android:text="독서카드 추가하기"
        android:textAppearance="@style/medium18"
        android:textColor="@color/white"
        android:enabled="true"
        android:background="@drawable/bg_round_20dp_gray900"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>