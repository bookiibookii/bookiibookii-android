<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/page">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

        <TextView
            android:id="@+id/lib_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/medium24"
            android:textColor="@color/grey_900"
            android:text="내 서재"
            android:layout_marginTop="3dp"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/lib_search_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lib_sort_iv"/>

        <ImageView
            android:id="@+id/lib_sort_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/ic_sort"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"/>
        
        <View
            android:id="@+id/lib_line_v"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_200"
            android:layout_marginTop="19dp"
            app:layout_constraintTop_toBottomOf="@id/lib_title_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/lib_btns_ll"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/lib_line_v"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintEnd_toEndOf="@id/guideline_end">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/lib_ing_btn"
                android:layout_width="168dp"
                android:layout_height="48dp"
                android:text="진행 중"
                android:textAppearance="@style/medium14"
                android:textColor="@color/white"
                android:background="@drawable/bg_toggle_black10" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/lib_ed_btn"
                android:layout_width="168dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="종료"
                android:textAppearance="@style/regular14"
                android:textColor="@color/grey_900"
                android:background="@drawable/bg_toggle_white10" />
        </LinearLayout>

        <TextView
            android:id="@+id/lib_total_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/grey_900"
            android:textAppearance="@style/regular14"
            android:layout_marginTop="16dp"
            android:text="9권"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/lib_btns_ll"/>

    <ImageView
        android:id="@+id/lib_list_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_grid"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/lib_btns_ll"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lib_book_list_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintTop_toBottomOf="@id/lib_list_iv"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_lib_book"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
