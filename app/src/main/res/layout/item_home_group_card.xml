<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="top">

        <!-- 책 표지 72x100dp -->
        <ImageView
            android:id="@+id/ivBookCover"
            android:layout_width="72dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_ui_bg_r8"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <Space android:layout_width="16dp" android:layout_height="match_parent" />

        <!-- 그룹 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 교환방식 칩 + 책 제목 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTradeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_main_pale_r8"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="직접"
                    android:textSize="11sp"
                    android:textColor="@color/ui_main"
                    android:fontFamily="@font/pretendard_medium" />

                <Space android:layout_width="6dp" android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvBookTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="책 제목"
                    android:textSize="16sp"
                    android:textColor="@color/grey_900"
                    android:fontFamily="@font/pretendard_medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- 저자 (장르) -->
            <TextView
                android:id="@+id/tvAuthorGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/grey_500"
                android:fontFamily="@font/pretendard_regular" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 예상 독서 기간 -->
            <TextView
                android:id="@+id/tvReadingPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/grey_700"
                android:fontFamily="@font/pretendard_regular" />

            <!-- 호스트 정보 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/ivHostProfile"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_grey300_circle"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <Space android:layout_width="4dp" android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvHostNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/grey_700"
                    android:fontFamily="@font/pretendard_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="15sp"
                    android:textColor="@color/grey_700"
                    android:fontFamily="@font/pretendard_regular" />

                <TextView
                    android:id="@+id/tvGroupName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/grey_500"
                    android:fontFamily="@font/pretendard_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- 상태 텍스트 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="매칭 전"
            android:textSize="14sp"
            android:textColor="@color/ui_point_red"
            android:fontFamily="@font/pretendard_regular" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
