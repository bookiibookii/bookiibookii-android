<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_round_20dp_white"
    android:elevation="2dp">

    <TextView
        android:id="@+id/item_myp_group_book_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="괴테는 모든 것을 말했다"
        android:textAppearance="@style/medium14"
        android:textColor="@color/grey_900"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_myp_group_badge_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="모집 중"
        android:textColor="@color/white"
        android:textAppearance="@style/medium11"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_round_8dp_gray300"
        android:backgroundTint="@color/pre_main"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_myp_group_book_title"
        app:layout_constraintBottom_toBottomOf="@id/item_myp_group_book_title" />

    <TextView
        android:id="@+id/item_myp_group_book_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="스즈키 유이 (소설)"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_500"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_myp_group_book_title" />

    <LinearLayout
        android:id="@+id/item_myp_group_tags_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_myp_group_book_author">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#메모환영"
            android:textAppearance="@style/regular11"
            android:textColor="@color/ui_main_sub"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#인사이트"
            android:textAppearance="@style/regular11"
            android:textColor="@color/ui_main_sub"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#깔끔"
            android:textAppearance="@style/regular11"
            android:textColor="@color/ui_main_sub"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_round_8dp_gray300"
            android:backgroundTint="@color/pre_sub_pale" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>