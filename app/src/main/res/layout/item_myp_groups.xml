<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_round_20dp_white"
    android:elevation="2dp">

    <TextView
        android:id="@+id/item_myp_group_book_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="괴테는 모든 것을 말했다"
        android:textAppearance="@style/medium14"
        android:textColor="@color/grey_900"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/item_myp_group_badge_tv"/>

    <TextView
        android:id="@+id/item_myp_group_badge_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="모집 중"
        android:textColor="@color/white"
        android:textAppearance="@style/medium11"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_round_8dp_gray300"
        android:backgroundTint="@color/pre_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_myp_group_book_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="스즈키 유이 (소설)"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_500"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_myp_group_book_title" />

    <LinearLayout
        android:id="@+id/item_myp_group_tags_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_myp_group_book_author">
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>