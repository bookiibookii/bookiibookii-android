<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_main">

        <!-- 중앙 로고 + 타이틀 이미지 영역 -->
        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.42">

            <!-- 심볼 로고 -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_bookii_logo_white" />

            <!-- 타이틀 이미지 -->
            <ImageView
                android:id="@+id/imgTitle"
                android:layout_width="204dp"
                android:layout_height="21.79dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_home_logo"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- 버튼 묶음(kakao,google 버튼) -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_login_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btn_kakao_login,btn_google_login" />

        <!-- 카카오 로그인 버튼 -->
        <include
            android:id="@+id/btn_kakao_login"
            layout="@layout/include_onb_login_button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/btn_google_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 구글 로그인 버튼 -->
        <include
            android:id="@+id/btn_google_login"
            layout="@layout/include_onb_login_button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@id/tv_terms_notice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 약관 안내 문구 (추가) -->
        <TextView
            android:id="@+id/tv_terms_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 로그인 성공 문구 -->
        <TextView
            android:id="@+id/tv_login_complete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인이 성공적으로 완료되었습니다"
            android:textSize="18sp"
            android:letterSpacing="-0.02"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_marginTop="250dp"
            app:layout_constraintTop_toBottomOf="@id/logoContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>