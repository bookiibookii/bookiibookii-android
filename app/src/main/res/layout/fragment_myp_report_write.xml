<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:background="@color/ui_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.92" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start_inner"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.08" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end_inner"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.92" />

        <ImageView
            android:id="@+id/myp_report_back_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="@id/guideline_start_inner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신고하기"
            android:textAppearance="@style/medium20"
            android:textColor="@color/grey_900"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_round_20dp_red_stroke"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:tint="@color/ui_point_red"
                        android:src="@drawable/ic_info_circle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="신고 시 유의사항"
                        android:textAppearance="@style/medium14"
                        android:textColor="@color/grey_700"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/grey_200" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="허위 신고는 제재 대상이 될 수 있습니다. 정확하고 객관적인 사실만 작성해 주세요."
                    android:textAppearance="@style/regular14"
                    android:textColor="@color/ui_point_red"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="신고 그룹 *"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <EditText
                    android:id="@+id/myp_report_group_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:hint="신고할 그룹을 선택해주세요"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_400"
                    android:paddingStart="20dp"/>

                <ImageView
                    android:id="@+id/myp_report_group_plus_iv"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_plus"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="신고 멤버"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <EditText
                    android:id="@+id/myp_report_member_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:hint="신고할 멤버를 선택해주세요"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_400"
                    android:paddingStart="20dp"/>

                <ImageView
                    android:id="@+id/myp_report_member_plus_iv"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_plus"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="24dp"
                android:text="신고 유형 *"
                android:textColor="#333333"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/myp_report_type_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/myp_report_type1_rb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_check_gray"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="16dp"
                    android:text="욕설/비방"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_900"/>

                <RadioButton
                    android:id="@+id/myp_report_type2_rb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_check_gray"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="16dp"
                    android:text="스팸/광고"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_900"/>
                <RadioButton
                    android:id="@+id/myp_report_type3_rb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_check_gray"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="16dp"
                    android:text="책 미발송/노쇼/연락두절"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_900"/>
                <RadioButton
                    android:id="@+id/myp_report_type4_rb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_check_gray"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="16dp"
                    android:text="책 파손/낙서"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_900"/>
                <RadioButton
                    android:id="@+id/myp_report_type5_rb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_round_20dp_white"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_check_gray"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="16dp"
                    android:text="텍스트"
                    android:textAppearance="@style/regular15"
                    android:textColor="@color/grey_900"/>

            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="신고 내용 *"
                android:textAppearance="@style/medium16"
                android:textColor="@color/grey_900"/>

            <EditText
                android:id="@+id/myp_report_content_et"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_input_round_20dp_white"
                android:gravity="top"
                android:hint="구체적인 상황을 설명해주세요."
                android:padding="20dp"
                android:textAppearance="@style/regular15"
                android:textColor="@color/grey_500"/>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/myp_write_btn"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="신고 전송"
        android:textAppearance="@style/medium18"
        android:clickable="false"
        android:textColor="@color/grey_500"
        android:background="@drawable/bg_round_20dp_gray200"
        android:backgroundTint="@color/grey_200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>