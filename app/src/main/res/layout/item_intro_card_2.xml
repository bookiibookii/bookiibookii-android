<?xml version="1.0" encoding="utf-8"?>
<!-- 카드 2: 독서 그룹 코멘트 카드 (서로의 문장을 공유하며 넓어지는 우리만의 서재) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="164dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 상단: 프로필 + 닉네임 + 북마크 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 프로필 -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/img_intro_profile_sayo"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />

                <!-- 닉네임 -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="sayo"
                    android:textAppearance="@style/regular11"
                    android:textColor="@color/grey_700" />

                <!-- 북마크 아이콘 -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bookmark_orange" />
            </LinearLayout>

            <!-- 코멘트 텍스트 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="여기서 개뿜음.. 도망가길 뭘 도망가 그만 웃겨라ㅜㅜ 아니 그리고 노쉘님께서 쓰신 코멘트가 너무 웃겨서 머릿속에서 떠나가질 않음 와 제발 살려줘"
                android:textAppearance="@style/medium11"
                android:textColor="@color/grey_700"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 별점 + 페이지 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/img_intro_postit" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="5"
                    android:textAppearance="@style/regular10"
                    android:textColor="@color/grey_500" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="72pg"
                    android:textAppearance="@style/regular10"
                    android:textColor="@color/grey_500" />
            </LinearLayout>

            <!-- 책 사진 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/grey_200">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_intro_book_photo" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
