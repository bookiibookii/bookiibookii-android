<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/grey_200" />

    <TextView
        android:id="@+id/tv_title_reading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="책을 읽고 있어요"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/grey_900"
        android:textSize="20sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_reading_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/grey_100"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/grey_200"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="예정 독서 기간 | "
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/grey_900"
                android:textSize="14sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025. 12. 19. "
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/grey_900"
                android:textSize="14sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~ "
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/pre_main"
                android:textSize="14sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_end_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025. 12. 25."
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/pre_main"
                android:textSize="14sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="원활한 교환독서를 위하여 책이 파손되지 않도록 유의해주세요."
        android:textColor="@color/grey_500"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_write_card"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="독서 카드 작성"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/grey_900"
        android:textSize="15sp"
        android:includeFontPadding="false"
        app:cornerRadius="16dp"
        app:strokeColor="@color/grey_200"
        app:strokeWidth="1dp"
        app:rippleColor="@color/grey_100" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_extend_period"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="독서 기간 연장"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/grey_900"
        android:textSize="15sp"
        android:includeFontPadding="false"
        app:cornerRadius="16dp"
        app:strokeColor="@color/grey_200"
        app:strokeWidth="1dp"
        app:rippleColor="@color/grey_100" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_finish"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/grey_900"
        android:text="다 읽었어요!"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/grey_100"
        android:textSize="15sp"
        android:includeFontPadding="false"
        app:cornerRadius="16dp" />

</LinearLayout>
