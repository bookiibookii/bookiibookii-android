<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_exchange_empty_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_20dp_white"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    tools:layout_width="340dp">

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="설명_1"
        android:textSize="14sp"
        android:letterSpacing="-0.02"
        android:textColor="@color/grey_900"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_empty_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="설명_2"
        android:textSize="12sp"
        android:letterSpacing="-0.02"
        android:textColor="@color/grey_600"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_empty_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_home_action"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="버튼"
        style="?attr/home_button_style"
        app:layout_constraintTop_toBottomOf="@id/tv_empty_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>