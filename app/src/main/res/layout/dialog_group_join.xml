<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_24dp_white"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_join_title_Tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_variable"
        android:text="그룹 참여 신청"
        android:textStyle="bold"
        android:textColor="@color/grey_900"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/dialog_join_close_Iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close_round"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/dialog_join_title_Tv"
        app:layout_constraintBottom_toBottomOf="@id/dialog_join_title_Tv"/>

    <TextView
        android:id="@+id/dialog_join_host_Tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/pretendard_variable"
        android:text="너도 매우매우 길어지면 어쩔껀데"
        android:textColor="@color/grey_700"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dialog_join_info_Tv"
        app:layout_constraintTop_toBottomOf="@id/dialog_join_title_Tv" />

    <TextView
        android:id="@+id/dialog_join_info_Tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="@font/pretendard_variable"
        android:layout_marginStart="4dp"
        android:text="매우매우매우길어지면 너가어쩔ㄱ건데 이 바보요"
        android:textColor="@color/grey_700"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/dialog_join_close_Iv"
        app:layout_constraintStart_toEndOf="@id/dialog_join_host_Tv"
        app:layout_constraintTop_toTopOf="@id/dialog_join_host_Tv" />

    <TextView
        android:id="@+id/dialog_join_label_Tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/pretendard_variable"
        android:text="신청 한 마디"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_join_info_Tv" />

    <TextView
        android:id="@+id/dialog_join_count_Tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_variable"
        android:text="0/200"
        android:textColor="@color/grey_500"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/dialog_join_label_Tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/dialog_join_label_Tv" />

    <EditText
        android:id="@+id/dialog_join_input_Et"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_round_16dp_gray100"
        android:padding="12dp"
        android:gravity="top|start"
        android:hint="호스트에게 간단한 소개를 남겨주세요."
        android:textColorHint="@color/grey_500"
        android:maxLength="200"
        android:textSize="14sp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_join_label_Tv" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_join_cancel_btn"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:fontFamily="@font/pretendard_variable"
        android:layout_marginTop="20dp"
        android:text="취소"
        android:textColor="@color/grey_900"
        app:backgroundTint="@color/white"
        app:cornerRadius="20dp"
        app:strokeColor="@color/grey_200"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_join_input_Et"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@id/dialog_join_input_Et" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_join_enter_btn"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:fontFamily="@font/pretendard_variable"
        android:layout_marginStart="12dp"
        android:text="확인"
        android:textColor="@color/grey_100"
        app:backgroundTint="@color/grey_900"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toTopOf="@id/dialog_join_cancel_btn"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@id/dialog_join_cancel_btn"/>

</androidx.constraintlayout.widget.ConstraintLayout>