<!--            android:layout_height="23dp" />-->

    </com.google.android.material.chip.ChipGroup>
    <FrameLayout
        android:id="@+id/grp_item_bottom_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grp_item_chip_group">

        <View
            android:id="@+id/grp_item_manage_Btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_20dp_pale" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/grp_item_btn_title_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_variable"
                android:text="참여 요청 관리"
                android:textColor="@color/pre_main"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/grp_item_btn_num_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/pretendard_variable"
                android:text="(5)"
                android:textColor="@color/pre_main"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>