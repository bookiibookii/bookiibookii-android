<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/lib_item_book_cv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/lib_item_book_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_300"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

<!--    <TextView-->
<!--        android:id="@+id/lib_item_book_title_tv"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:textAppearance="@style/medium11"-->
<!--        android:textColor="@color/grey_900"-->
<!--        android:text="괴테는 모든 것을 말했다."-->
<!--        android:layout_marginTop="8dp"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/lib_item_book_iv"/>-->

    <TextView
        android:id="@+id/lib_item_book_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/medium11"
        android:textColor="@color/grey_900"
        android:text="괴테는 모든 것을 말했다."
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:minLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lib_item_book_cv"/>

    <TextView
        android:id="@+id/lib_item_state_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/medium11"
        android:textColor="@color/pre_sub"
        android:text="트래커 상태"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lib_item_book_title_tv"/>

    <LinearLayout
        android:id="@+id/lib_rate_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/lib_item_book_title_tv"
        android:visibility="invisible">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_filled"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_filled"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_filled"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_filled"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_filled"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/lib_item_profile_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_circle_gray500"
        app:layout_constraintTop_toBottomOf="@id/lib_item_book_title_tv"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="28dp"/>

    <TextView
        android:id="@+id/lib_item_profile_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/medium11"
        android:textColor="@color/grey_700"
        android:text="noshel"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/lib_item_profile_iv"
        app:layout_constraintTop_toTopOf="@id/lib_item_profile_iv"/>

</androidx.constraintlayout.widget.ConstraintLayout>