<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_round_20dp_white"
    android:padding="16dp">

    <ImageView
        android:id="@+id/item_question_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_question"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/item_question_user_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        tools:text="noshel"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_900"
        app:layout_constraintBottom_toBottomOf="@id/item_question_iv"
        app:layout_constraintStart_toEndOf="@id/item_question_iv"
        app:layout_constraintTop_toTopOf="@id/item_question_iv"/>

    <TextView
        android:id="@+id/item_question_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2024. 11. 29."
        android:textAppearance="@style/regular11"
        android:textColor="@color/grey_400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_question_iv"
        app:layout_constraintBottom_toBottomOf="@id/item_question_iv"/>

    <TextView
        android:id="@+id/item_question_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        tools:text="책 배송 관련 문의드립니다."
        android:textAppearance="@style/semibold14"
        android:textColor="@color/grey_900"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_question_iv"/>

    <TextView
        android:id="@+id/item_question_content_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="안녕하세요, 혹시 책 배송은 어떻게 진행되나요?"
        android:textAppearance="@style/regular14"
        android:textColor="@color/grey_900"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_question_title_tv"/>

    <TextView
        android:id="@+id/item_question_answer_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_round_10dp_gray300_stroke"
        android:backgroundTint="@color/grey_100"
        android:gravity="center"
        android:padding="12dp"
        android:text="답변 대기 중입니다"
        android:textAppearance="@style/regular12"
        android:textColor="@color/grey_500"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/item_question_content_tv"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_question_answer_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_round_10dp_gray300_stroke"
        android:backgroundTint="@color/grey_100"
        android:padding="12dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/item_question_content_tv">

        <TextView
        android:id="@+id/item_question_admin_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="부키부키 팀"
        android:textAppearance="@style/regular12"
            android:textColor="@color/pre_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/item_question_answer_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2024. 11. 29."
            android:textAppearance="@style/regular11"
            android:textColor="@color/grey_400"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/item_question_answer_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="안녕하세요! 책 배송은 택배 또는 우편으로 진행됩니다."
            android:textAppearance="@style/regular14"
            android:textColor="@color/grey_900"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/item_question_admin_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>