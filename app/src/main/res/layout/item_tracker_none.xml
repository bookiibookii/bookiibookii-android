<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="80dp"
            android:layout_height="110dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:src="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_book_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="24dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="책 제목"
            android:textColor="@color/grey_800"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_book_cover"
            app:layout_constraintTop_toTopOf="@id/iv_book_cover" />

        <TextView
            android:id="@+id/tv_book_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="저자"
            android:textColor="@color/grey_600"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_regular"
            app:layout_constraintStart_toStartOf="@id/tv_book_title"
            app:layout_constraintTop_toBottomOf="@id/tv_book_title" />

        <TextView
            android:id="@+id/tv_book_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="카테고리"
            android:textColor="@color/grey_600"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_regular"
            app:layout_constraintStart_toEndOf="@id/tv_book_author"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_book_author" />

        <TextView
            android:id="@+id/tv_with"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="with"
            android:textColor="@color/grey_500"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toStartOf="@id/tv_book_title"
            app:layout_constraintTop_toBottomOf="@id/tv_book_author" />

        <TextView
            android:id="@+id/tv_with_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            android:text="noshel"
            android:textColor="@color/grey_800"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toEndOf="@id/tv_with"
            app:layout_constraintTop_toBottomOf="@id/tv_book_author" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/grey_100"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_book_cover" />

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:text="좋아요! 계속 이대로만 읽어주세요 😊"
            android:textColor="@color/grey_500"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <TextView
            android:id="@+id/tv_my_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:text="나의 독서율"
            android:textSize="14sp"
            android:textColor="@color/pre_main"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_message" />

        <TextView
            android:id="@+id/tv_my_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="79%"
            android:textSize="14sp"
            android:textColor="@color/pre_main"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_my_label"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_progress_compare"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_my_label">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.83" />

            <View
                android:id="@+id/view_track_bg"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_progress_track"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/view_track_group"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_progress_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/view_track_bg"
                app:layout_constraintTop_toTopOf="@id/view_track_bg"
                app:layout_constraintBottom_toBottomOf="@id/view_track_bg"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.83"
                app:layout_constraintHorizontal_bias="0" />

            <View
                android:id="@+id/view_track_fill"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_progress_fill"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/view_track_bg"
                app:layout_constraintTop_toTopOf="@id/view_track_bg"
                app:layout_constraintBottom_toBottomOf="@id/view_track_bg"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.79"
                app:layout_constraintHorizontal_bias="0" />

            <ImageView
                android:id="@+id/dot_my"
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:srcCompat="@drawable/bg_circle_grey100"
                app:layout_constraintStart_toEndOf="@id/view_track_fill"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constrainedWidth="true"
                android:translationX="-5dp"/>

            <ImageView
                android:id="@+id/dot_group"
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:srcCompat="@drawable/bg_circle_grey100"
                app:layout_constraintStart_toStartOf="@id/guideline_group"
                app:layout_constraintEnd_toEndOf="@id/guideline_group"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_group_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:text="그룹 평균 독서율"
            android:textSize="14sp"
            android:textColor="@color/grey_800"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_progress_compare" />

        <TextView
            android:id="@+id/tv_group_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="83%"
            android:textSize="14sp"
            android:textColor="@color/grey_800"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_group_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
