<?xml version="1.0" encoding="utf-8"?>
<!-- TODO: background 원본 @drawable/bg_round_20dp_white -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_marginBottom="12dp">

    <!-- TODO: src 원본 @drawable/ic_onb_record_focus, background 원본 @drawable/bg_circle_main_pale -->
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:color/transparent"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="알림 제목"
        android:textColor="@color/grey_900"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/iv_icon"
        app:layout_constraintTop_toTopOf="@id/iv_icon" />

    <!-- TODO: background 원본 @drawable/ic_home_badge -->
    <View
        android:id="@+id/view_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/tv_title"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="15dp"
        android:text="알림 본문"
        android:textColor="@color/grey_700"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/iv_icon"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 메타 영역 -->
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        android:text="5분 전"
        android:textColor="@color/grey_400"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/iv_icon"
        app:layout_constraintTop_toBottomOf="@id/tv_body" />

    <TextView
        android:id="@+id/tv_dot_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="·"
        android:textColor="@color/grey_400"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/tv_time"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_time" />

    <TextView
        android:id="@+id/tv_book"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="책 제목"
        android:textColor="@color/grey_400"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/tv_dot_meta"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_time"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>