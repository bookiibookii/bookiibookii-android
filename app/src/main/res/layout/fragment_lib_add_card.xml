<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <!-- 상단 앱바 영역 -->
    <ImageButton
        android:id="@+id/lib_add_back_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_back"
        android:layout_marginTop="65.5dp"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lib_add_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/medium20"
        android:textColor="@color/grey_900"
        android:text="카드 추가"
        app:layout_constraintTop_toTopOf="@id/lib_add_back_iv"
        app:layout_constraintBottom_toBottomOf="@id/lib_add_back_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/lib_line_v"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grey_200"
        android:layout_marginTop="14.5dp"
        app:layout_constraintTop_toBottomOf="@id/lib_add_back_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 이미지 업로드 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lib_add_card_cv"
        android:layout_width="340dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/grey_200"
        app:layout_constraintTop_toBottomOf="@id/lib_line_v"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_upload" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="사진 업로드"
                android:textAppearance="@style/regular14"
                android:textColor="@color/grey_800" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 페이지 입력 -->
    <TextView
        android:id="@+id/lib_add_page_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="페이지"
        android:textAppearance="@style/regular16"
        android:textColor="@color/grey_900"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lib_add_card_cv"
        app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <EditText
        android:id="@+id/lib_add_page_et"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_round_20dp_white"
        android:paddingHorizontal="12dp"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/lib_add_page_tv"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end" />

    <!-- 메모 입력 -->
    <TextView
        android:id="@+id/lib_add_memo_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="메모"
        android:textAppearance="@style/regular16"
        android:textColor="@color/grey_900"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lib_add_page_et"
        app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <EditText
        android:id="@+id/lib_add_memo_et"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_round_20dp_white"
        android:paddingHorizontal="12dp"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/lib_add_memo_tv"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end" />

    <!-- 하단 버튼 -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="등록하기"
        android:enabled="false"
        android:background="@drawable/bg_round_20dp_gray200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
