<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:fitsSystemWindows="true"
android:background="@color/ui_bg">

<androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_percent="0.08" />

<androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline_end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_percent="0.92" />

<!-- 상단 배경 영역 -->
<LinearLayout
    android:id="@+id/lib_top_layout"
    android:layout_width="match_parent"
    android:layout_height="73dp"
    android:orientation="vertical"
    android:background="@color/white"
    app:layout_constraintTop_toTopOf="parent">

    <!-- 내부 콘텐츠 정렬용 ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🔹 내부 전용 가이드라인 (중요) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start_inner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.08" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end_inner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.92" />

        <ImageButton
            android:id="@+id/lib_add_back_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="@id/guideline_start_inner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/lib_add_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/medium20"
            android:textColor="@color/grey_900"
            android:text="카드 추가"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lib_add_card_cv"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/grey_200"
        app:layout_constraintTop_toBottomOf="@id/lib_top_layout"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/lib_add_card_guide_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_upload" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="사진 업로드"
                    android:textAppearance="@style/regular14"
                    android:textColor="@color/grey_800" />
            </LinearLayout>

            <ImageView
                android:id="@+id/lib_add_card_preview_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/lib_add_card_edit_iv"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

<TextView
    android:id="@+id/lib_add_page_tv"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="페이지"
    android:textAppearance="@style/regular16"
    android:textColor="@color/grey_900"
    android:layout_marginTop="12dp"
    app:layout_constraintTop_toBottomOf="@id/lib_add_card_cv"
    app:layout_constraintStart_toStartOf="@id/guideline_start" />

<EditText
    android:id="@+id/lib_add_page_et"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_input_round_20dp_white"
    android:paddingHorizontal="12dp"
    android:inputType="number"
    android:textColor="@color/grey_900"
    app:layout_constraintTop_toBottomOf="@id/lib_add_page_tv"
    app:layout_constraintStart_toStartOf="@id/guideline_start"
    app:layout_constraintEnd_toEndOf="@id/guideline_end" />

<TextView
    android:id="@+id/lib_add_memo_tv"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="메모"
    android:textAppearance="@style/regular16"
    android:textColor="@color/grey_900"
    android:layout_marginTop="12dp"
    app:layout_constraintTop_toBottomOf="@id/lib_add_page_et"
    app:layout_constraintStart_toStartOf="@id/guideline_start" />

    <EditText
        android:id="@+id/lib_add_memo_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_round_20dp_white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/grey_900"
        android:inputType="textMultiLine|text"
        app:layout_constraintTop_toBottomOf="@id/lib_add_memo_tv"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end" />

<androidx.appcompat.widget.AppCompatButton
    android:id="@+id/lib_add_btn"
    android:layout_width="0dp"
    android:layout_height="72dp"
    android:text="등록하기"
    android:enabled="false"
    android:background="@drawable/bg_round_20dp_gray200"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>
